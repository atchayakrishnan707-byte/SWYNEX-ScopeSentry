
# Application Configuration
APP_NAME=ScopeSentry
APP_ENV=development
DEBUG=True

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
